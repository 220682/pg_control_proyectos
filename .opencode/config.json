{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp"],
      "enabled": true
    }
  },
  "agent": {
    "general": { "model": "opencode-go/qwen3.8-plus", "effort": "medium" },
    "explore": { "model": "opencode-go/qwen3.8-flash", "effort": "low" },
    "orchestrator": {
      "model": "opencode-go/qwen3.8-plus",
      "effort": "medium-high",
      "note": "Victor elige Max o Plus al iniciar sesión"
    },
    "roles": {
      "architect": {
        "default": "opencode-go/qwen3.8-max",
        "effort": "high",
        "alternatives": ["opencode-go/qwen3.8-plus"]
      },
      "planner": {
        "default": "opencode-go/qwen3.8-plus",
        "effort": "medium-high",
        "alternatives": ["opencode-go/qwen3.8-flash"]
      },
      "worker": {
        "default": "opencode-go/qwen3.8-flash",
        "levels": {
          "flash": {
            "model": "opencode-go/qwen3.8-flash",
            "effort": "low",
            "criteria": "Simple, bien especificada, sin ambigüedad, sin dependencias, sin riesgo"
          },
          "plus": {
            "model": "opencode-go/qwen3.8-plus",
            "effort": "medium",
            "criteria": "Requiere análisis, tiene dependencias, o afecta múltiples archivos/flujos"
          },
          "max": {
            "model": "opencode-go/qwen3.8-max",
            "effort": "high",
            "criteria": "Razonamiento profundo, remota, o riesgo alto",
            "requires_approval": true,
            "log_always": true
          }
        }
      },
      "documenter": {
        "default": "opencode-go/qwen3.8-flash",
        "effort": "low-medium",
        "alternatives": ["opencode-go/qwen3.8-plus"]
      },
      "auditor": {
        "default": "opencode-go/qwen3.8-plus",
        "effort": "high",
        "alternatives": ["opencode-go/qwen3.8-max"]
      },
      "git": {
        "default": "opencode-go/qwen3.8-flash",
        "effort": "low"
      }
    },
    "jev": {
      "model": "typesafe/jev-1.13",
      "endpoint": "https://openrouter.ai/api/alpha/decisions",
      "use_for": ["merge", "push", "delete", "migrate", "branch", "close"],
      "thresholds": { "continue": 0.9, "block": 0.1, "escalate": 0.5 }
    },
    "context_thresholds": {
      "green": 200000,
      "yellow": 300000,
      "red": 350000,
      "note": "Tokens. Verde: normal. Amarillo: no abrir frentes nuevos. Rojo: relevo."
    }
  }
}
